---
import Layout from '../layouts/Layout.astro';
import brandsData from '../data/brands.json';

export function getStaticPaths() {
  const twBrands = brandsData.filter(b => b.country === 'tw');
  return twBrands.map((b) => ({
    params: { brand: b.id },
    props: { brandData: b }
  }));
}

const { brandData } = Astro.props;
---

<Layout>
  <!-- Hero Section -->
  <div class="relative min-h-[60vh] flex items-center pt-20 pb-12 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-slate-950 z-0">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-yellow-700 via-slate-900 to-slate-950"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="w-full md:w-1/3 flex justify-center">
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-yellow-600 to-yellow-400 rounded-2xl blur opacity-30 group-hover:opacity-60 transition duration-1000 group-hover:duration-200 animate-pulse"></div>
            <div class="relative bg-slate-900 p-8 rounded-2xl border border-slate-800 shadow-2xl flex items-center justify-center aspect-square w-64 h-64 md:w-80 md:h-80">
              <img src={brandData.logo} alt={brandData.name} class="w-full h-full object-contain filter drop-shadow-lg" />
            </div>
          </div>
        </div>
        
        <div class="w-full md:w-2/3 text-center md:text-left">
          <a href="/" class="inline-flex items-center text-yellow-600 hover:text-yellow-400 text-sm tracking-widest uppercase mb-6 transition-colors group">
            <span class="mr-2 transform group-hover:-translate-x-1 transition-transform">←</span> 返回首頁
          </a>
          
          <h1 class="text-4xl md:text-6xl font-bold text-slate-100 tracking-wider mb-4 drop-shadow-md">
            {brandData.name}
          </h1>
          
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mb-8">
            <span class="px-4 py-1.5 rounded-full bg-yellow-500/10 text-yellow-500 border border-yellow-500/20 text-sm font-bold tracking-wider">
              {brandData.rating} ★ 評價
            </span>
            <span class="px-4 py-1.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-sm tracking-wider">
              官方認證品牌
            </span>
          </div>
          
          <div class="bg-slate-900/50 backdrop-blur-sm border border-slate-800 rounded-xl p-6 mb-8 inline-block shadow-lg">
            <p class="text-yellow-500 text-sm font-bold tracking-widest uppercase mb-1">獨家優惠</p>
            <p class="text-2xl text-slate-100 font-bold">{brandData.bonus}</p>
          </div>
          
          <div>
            <a href="#" class="inline-flex items-center justify-center px-10 py-4 text-slate-900 font-bold text-lg uppercase tracking-widest bg-gradient-to-r from-yellow-400 via-yellow-300 to-yellow-500 rounded-lg hover:from-yellow-300 hover:via-yellow-200 hover:to-yellow-400 transform hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(234,179,8,0.4)] transition-all duration-300 w-full md:w-auto">
              立即遊玩 <span class="ml-2">→</span>
            </a>
            <p class="text-slate-500 text-xs mt-3 font-light tracking-wide">本網站僅提供成人使用。未滿18歲請勿註冊。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-slate-100 mb-6 flex items-center gap-3">
          <span class="w-1 h-6 bg-yellow-500 rounded-full inline-block"></span>
          關於 {brandData.name}
        </h2>
        <div class="prose prose-invert prose-slate max-w-none text-slate-300 leading-relaxed text-lg">
          <p>{brandData.description}</p>
          <p class="mt-4">
            我們提供頂級的遊戲體驗，包含真人視訊、老虎機、體育賽事等豐富多樣的選擇。提供極速的出入金服務以及 24 小時不間斷的客戶支援。
          </p>
          <ul class="mt-6 space-y-2">
            <li>✓ 頂級真人美女荷官</li>
            <li>✓ 千款熱門老虎機遊戲</li>
            <li>✓ 極速 5 分鐘提款到帳</li>
            <li>✓ VIP 尊榮回饋計畫</li>
          </ul>
        </div>
      </div>
      
      <div class="lg:col-span-1">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-lg sticky top-6">
          <h3 class="text-lg font-bold text-slate-100 mb-4 border-b border-slate-800 pb-3">重點資訊</h3>
          <ul class="space-y-4 text-sm">
            <li class="flex justify-between">
              <span class="text-slate-400">提款速度</span>
              <span class="text-slate-200 font-bold">極速 5 分鐘</span>
            </li>
            <li class="flex justify-between">
              <span class="text-slate-400">手機支援</span>
              <span class="text-green-400 font-bold">iOS & Android App</span>
            </li>
            <li class="flex justify-between">
              <span class="text-slate-400">客服中心</span>
              <span class="text-slate-200 font-bold">24 小時線上客服</span>
            </li>
            <li class="flex justify-between">
              <span class="text-slate-400">支援幣別</span>
              <span class="text-slate-200 font-bold">TWD / USDT</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>
