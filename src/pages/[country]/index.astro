---
import Layout from '../../layouts/Layout.astro';
import brandsData from '../../data/brands.json';

export function getStaticPaths() {
  const countries = [
    { code: 'tw', name: '台灣區推薦', subtitle: 'Taiwan Premium Selection' },
    { code: 'in', name: 'Indian Top Casinos', subtitle: 'Exclusive Deals for India' },
    { code: 'ph', name: 'Philippines Selection', subtitle: 'Top Rated in PH' },
    { code: 'hk', name: '香港精選娛樂城', subtitle: 'Hong Kong VIP Choices' },
    { code: 'bd', name: 'Bangladesh Casinos', subtitle: 'Best Local Brands' }
  ];
  
  return countries.map((c) => ({
    params: { country: c.code },
    props: {
      regionInfo: c,
      brands: brandsData.filter((b) => b.country === c.code)
    }
  }));
}

const { country } = Astro.params;
const { regionInfo, brands } = Astro.props;
---

<Layout>
  <div class="max-w-7xl mx-auto px-4 py-12 relative z-10">
    <!-- Header -->
    <div class="flex items-center justify-between mb-12 border-b border-slate-800 pb-6">
      <div>
        <a href="/" class="text-yellow-600 hover:text-yellow-400 text-sm tracking-widest uppercase mb-2 inline-block transition-colors">← Back to Global</a>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-100 tracking-wider">
          {regionInfo.name}
        </h1>
        <p class="text-slate-400 mt-2 font-['Cinzel'] tracking-widest uppercase text-sm">{regionInfo.subtitle}</p>
      </div>
    </div>

    <!-- Brands Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {brands.map((brand) => (
        <a 
          href={`/${country}/${brand.id}`}
          class="group relative bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-yellow-500/50 transition-all duration-300 hover:shadow-[0_10px_30px_rgba(234,179,8,0.15)] hover:-translate-y-1 flex flex-col"
        >
          <!-- Shiny Overlay on hover -->
          <div class="absolute inset-0 bg-gradient-to-tr from-yellow-500/0 via-yellow-500/0 to-yellow-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

          <!-- Logo Container -->
          <div class="aspect-video bg-slate-950 p-6 flex items-center justify-center relative overflow-hidden border-b border-slate-800">
             <!-- Fake glow behind logo -->
             <div class="absolute inset-0 bg-yellow-500/10 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-full scale-150"></div>
             
             <img 
               src={brand.logo} 
               alt={brand.name} 
               class="w-full h-full object-contain relative z-10 filter drop-shadow-lg transform group-hover:scale-105 transition-transform duration-500"
               loading="lazy"
             />
          </div>

          <!-- Content -->
          <div class="p-6 flex-grow flex flex-col">
            <h2 class="text-xl font-bold text-slate-200 group-hover:text-yellow-400 transition-colors mb-2">{brand.name}</h2>
            <p class="text-sm text-yellow-500/80 mb-4 font-bold flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>
              {brand.bonus}
            </p>
            <p class="text-slate-400 text-sm line-clamp-2 mt-auto">
              {brand.description}
            </p>
          </div>
          
          <!-- Bottom Action Bar -->
          <div class="bg-slate-950/50 p-4 border-t border-slate-800/50 flex justify-between items-center group-hover:bg-yellow-500/5 transition-colors">
            <span class="text-xs text-slate-500">Rating: <span class="text-yellow-500 font-bold ml-1">{brand.rating} ★</span></span>
            <span class="text-yellow-500 text-sm font-bold tracking-widest uppercase flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Review <span class="text-lg leading-none">→</span>
            </span>
          </div>
        </a>
      ))}
      
      {brands.length === 0 && (
        <div class="col-span-full py-20 text-center">
           <p class="text-slate-500 text-lg">No brands available for this region yet.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
