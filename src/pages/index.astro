---
import Layout from '../layouts/Layout.astro';

const regions = [
  { code: 'tw', name: '台灣 / Taiwan', icon: '🇹🇼', desc: '繁體中文市場', color: 'from-blue-900 to-slate-900' },
  { code: 'in', name: 'India', icon: '🇮🇳', desc: 'English Market', color: 'from-orange-900 to-slate-900' },
  { code: 'ph', name: 'Philippines', icon: '🇵🇭', desc: 'English Market', color: 'from-red-900 to-slate-900' },
  { code: 'hk', name: '香港 / Hong Kong', icon: '🇭🇰', desc: '繁體中文市場', color: 'from-purple-900 to-slate-900' },
  { code: 'bd', name: 'Bangladesh', icon: '🇧🇩', desc: 'Regional Market', color: 'from-emerald-900 to-slate-900' },
];
---

<Layout>
  <main class="min-h-screen flex flex-col items-center justify-center p-6 pt-20">
    <div class="text-center mb-16 relative">
      <div class="absolute -inset-x-20 top-1/2 -translate-y-1/2 h-px bg-gradient-to-r from-transparent via-yellow-500/50 to-transparent"></div>
      <h1 class="font-['Cinzel'] text-5xl md:text-7xl font-bold tracking-widest text-transparent bg-clip-text bg-gradient-to-b from-yellow-300 via-yellow-500 to-yellow-700 uppercase drop-shadow-[0_0_15px_rgba(234,179,8,0.3)] inline-block px-8 bg-slate-950 relative z-10">
        Premium Casino
      </h1>
      <p class="text-yellow-500/80 mt-4 tracking-[0.3em] font-light uppercase text-sm md:text-base bg-slate-950 inline-block px-4">Global Selection Hub</p>
    </div>

    <div class="w-full max-w-5xl mx-auto">
      <p class="text-center text-slate-400 mb-8 text-lg font-light">請選擇您的所在地區 / Please select your region</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {regions.map((region) => (
          <a 
            href={`/${region.code}/`}
            class={`group relative overflow-hidden rounded-2xl bg-gradient-to-br ${region.color} p-[1px] transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(234,179,8,0.2)]`}
          >
            <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm transition-colors group-hover:bg-slate-950/60"></div>
            
            <!-- Animated Border effect -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
               <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-yellow-500 to-transparent"></div>
               <div class="absolute inset-y-0 right-0 w-px bg-gradient-to-b from-transparent via-yellow-500 to-transparent"></div>
               <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-yellow-500 to-transparent"></div>
               <div class="absolute inset-y-0 left-0 w-px bg-gradient-to-b from-transparent via-yellow-500 to-transparent"></div>
            </div>

            <div class="relative z-10 p-8 flex flex-col items-center justify-center text-center h-full">
              <span class="text-5xl mb-4 drop-shadow-md transform transition-transform group-hover:-translate-y-2 group-hover:scale-110 duration-300">{region.icon}</span>
              <h2 class="text-2xl font-bold text-slate-100 tracking-wide mb-2 group-hover:text-yellow-400 transition-colors">{region.name}</h2>
              <p class="text-slate-400 text-sm group-hover:text-slate-300 transition-colors">{region.desc}</p>
              
              <div class="mt-6 overflow-hidden h-0 group-hover:h-8 transition-all duration-300 ease-in-out opacity-0 group-hover:opacity-100 flex items-center text-yellow-500 text-sm font-bold tracking-widest uppercase">
                Enter Region <span class="ml-2">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
